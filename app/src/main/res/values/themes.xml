<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.CNARScreenTranslator" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark_color</item>
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/secondary_dark_color</item>
        <item name="colorError">@color/error_color</item>
        <item name="colorErrorDark">@color/error_dark_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnBackground">@color/text_color</item>
        <item name="colorOnSurface">@color/text_color</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/text_color</item>
        <item name="android:textColorSecondary">@color/text_secondary_color</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">14sp</item>

        <!-- ActionBar -->
        <item name="android:actionBarStyle">@style/ActionBar</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/primary_dark_color</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Action Bar style -->
    <style name="ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="android:background">@color/primary_color</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Floating Action Button style -->
    <style name="FloatingActionButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@color/primary_color</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Button style -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/button_background</item>
    </style>

    <!-- EditText style -->
    <style name="AppEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textColorHint">@color/text_secondary_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

    <!-- Card style -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:elevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_color</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Text styles -->
    <style name="AppHeading1">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="AppHeading2">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="AppHeading3">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="AppBody1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="AppBody2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="AppCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary_color</item>
    </style>

    <!-- Overlay translation style -->
    <style name="TranslationOverlay">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Dialog style -->
    <style name="AppDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/surface_color</item>
        <item name="android:textColorPrimary">@color/text_color</item>
        <item name="android:textColorSecondary">@color/text_secondary_color</item>
        <item name="buttonBarButtonStyle">@style/DialogButton</item>
    </style>

    <!-- Dialog button style -->
    <style name="DialogButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Toolbar style -->
    <style name="AppToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary_color</item>
        <item name="android:elevation">4dp</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <!-- Progress bar style -->
    <style name="AppProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">@color/primary_color</item>
    </style>

    <!-- Switch style -->
    <style name="AppSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textColor">@color/text_color</item>
    </style>

    <!-- SeekBar style -->
    <style name="AppSeekBar" parent="Widget.AppCompat.SeekBar.Discrete">
        <item name="android:progressTint">@color/primary_color</item>
        <item name="android:progressBackgroundTint">@color/secondary_color</item>
    </style>

    <!-- PreferenceCategory style -->
    <style name="AppPreferenceCategory" parent="Preference.Category">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_color</item>
    </style>

</resources>
